# Backend server port (default: 5174)
PORT=5174

# Database: postgres | sqlite (default: sqlite)
# DATABASE_TYPE=sqlite

# PostgreSQL (when DATABASE_TYPE=postgres)
# DATABASE_URL=postgresql://user:password@localhost:5432/marketplace

# SQLite (when DATABASE_TYPE=sqlite, default path)
# DATABASE_PATH=./data/marketplace.db

# MongoDB - required for marketplace data (tenant requests, tenants, workflows, job postings, employer profiles)
# Put your MongoDB connection URL here (local or Atlas):
#   Local:   mongodb://localhost:27017
#   Atlas:   mongodb+srv://user:password@cluster.mongodb.net/marketplace
MONGO_URI=mongodb://localhost:27017

# Optional: database name (default: marketplace)
# MONGO_DATABASE=marketplace

# CORS: comma-separated allowed origins (leave empty to allow all - dev only)
# Example: CORS_ORIGIN=https://marketplace.example.com
# CORS_ORIGIN=

# Marketplace Admin (ACA-Py) - for tenant provisioning, workflow controller, credential signing
# When a tenant request is approved, a MarketplaceProfileCredential is issued via POST /vc/sign
# MARKETPLACE_ADMIN_URI=http://localhost:8031
# MARKETPLACE_ADMIN_API_KEY=your-api-key

# Marketplace Tenancy (ACA-Py multitenant) - sub-wallets per employer
# MARKETPLACE_TENANCY_URI=http://localhost:8032
# MARKETPLACE_TENANCY_API_KEY=your-api-key

# Frontend (Vite) - build-time env vars, prefixed with VITE_
# App icon URL (favicon, header logo). Optional - defaults to /img/digicred/logo-marketplace.svg
# VITE_ICON_URL=https://example.com/icon.png
