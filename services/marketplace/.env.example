# Backend server port (default: 5174)
PORT=5174

# Database: postgres | sqlite (default: sqlite)
# DATABASE_TYPE=sqlite

# PostgreSQL (when DATABASE_TYPE=postgres)
# DATABASE_URL=postgresql://user:password@localhost:5432/marketplace

# SQLite (when DATABASE_TYPE=sqlite, default path)
# DATABASE_PATH=./data/marketplace.db

# MongoDB - required for marketplace data (tenant requests, tenants, workflows, job postings, employer profiles)
# Put your MongoDB connection URL here (local or Atlas):
#   Local:   mongodb://localhost:27017
#   Atlas:   mongodb+srv://user:password@cluster.mongodb.net/marketplace
MONGO_URI=mongodb://localhost:27017

# Optional: database name (default: marketplace)
# MONGO_DATABASE=marketplace

# Marketplace base URL for credential @context and OOB redirect target (default: http://localhost:5174)
# Used to build MARKETPLACE_CONTEXT_URI when not set. Credentials reference /ns/marketplace/v1
# In dev with separate frontend (5175) and backend (5174), set to frontend URL so OOB redirects load the SPA:
# MARKETPLACE_BASE_URL=http://localhost:5175
# MARKETPLACE_BASE_URL=https://marketplace.example.com

# Override marketplace JSON-LD context URI (default: ${MARKETPLACE_BASE_URL}/ns/marketplace/v1)
# MARKETPLACE_CONTEXT_URI=https://marketplace.example.com/ns/marketplace/v1

# Credential issuer (object with id as did:web, name, image, description)
# Default: did:web derived from MARKETPLACE_BASE_URL (e.g. did:web:marketplace.example.com)
# MARKETPLACE_ISSUER_ID=did:web:marketplace.example.com
# MARKETPLACE_ISSUER_NAME=Apply Utopia Marketplace
# MARKETPLACE_ISSUER_IMAGE=https://marketplace.example.com/img/logo.svg
# MARKETPLACE_ISSUER_DESCRIPTION=The Apply Utopia marketplace for jobs, scholarships, and services.

# CORS: comma-separated allowed origins (leave empty to allow all - dev only)
# Example: CORS_ORIGIN=https://marketplace.example.com
# CORS_ORIGIN=

# Marketplace Agency - single multitenant ACA-Py agent (Innkeeper + Marketplace plugins)
# Used for tenant provisioning, invitations, transcript analysis
# MARKETPLACE_AGENCY_URI=http://localhost:8031
# MARKETPLACE_AGENCY_API_KEY=your-api-key

# Innkeeper tenant Bearer token - required for /vc/sign (credential issuance)
# Get from agent startup logs or POST /multitenancy/tenant/{tenant_id}/token
# MARKETPLACE_INNKEEPER_TOKEN=your-bearer-token

# Frontend (Vite) - build-time env vars, prefixed with VITE_
# App icon URL (favicon, header logo). Optional - defaults to /img/digicred/logo-marketplace.svg
# VITE_MARKETPLACE_ICON=https://example.com/icon.png
