{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketplace.example.com/schemas/CourseCredential.json",
  "title": "CourseCredential",
  "description": "W3C Verifiable Credential wrapping a schema.org Course. Use for verifiable course listings from education institutions.",
  "type": "object",
  "properties": {
    "@context": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2,
      "description": "First: https://www.w3.org/ns/credentials/v2, second: https://schema.org"
    },
    "type": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2
    },
    "id": { "type": "string", "format": "uri" },
    "issuer": { "type": ["string", "object"] },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "credentialSubject": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uri" },
        "type": { "const": "Course" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "courseCode": { "type": "string" },
        "numberOfCredits": { "type": "number" },
        "coursePrerequisites": { "type": ["string", "object", "array"] },
        "educationalCredentialAwarded": { "type": ["string", "object"] },
        "provider": { "type": "object" },
        "hasCourseInstance": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "const": "CourseInstance" },
              "courseMode": { "type": ["string", "array"] },
              "startDate": { "type": "string", "format": "date" },
              "endDate": { "type": "string", "format": "date" },
              "location": { "type": "object" }
            }
          }
        }
      },
      "required": ["id", "type", "name", "description"]
    }
  },
  "required": ["@context", "type", "issuer", "credentialSubject"]
}
