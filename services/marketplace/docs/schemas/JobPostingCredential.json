{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketplace.example.com/schemas/JobPostingCredential.json",
  "title": "JobPostingCredential",
  "description": "W3C Verifiable Credential wrapping a schema.org JobPosting. Use for verifiable job listings.",
  "type": "object",
  "properties": {
    "@context": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2,
      "description": "First: https://www.w3.org/ns/credentials/v2, second: https://schema.org"
    },
    "type": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2
    },
    "id": { "type": "string", "format": "uri" },
    "issuer": { "type": ["string", "object"] },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "credentialSubject": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uri" },
        "type": { "const": "JobPosting" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "datePosted": { "type": "string", "format": "date-time" },
        "validThrough": { "type": "string", "format": "date-time" },
        "employmentType": { "type": "string" },
        "hiringOrganization": { "type": "object" },
        "jobLocation": { "type": "object" },
        "baseSalary": { "type": "object" },
        "skills": { "type": "array", "items": { "type": "string" } },
        "qualifications": { "type": "array", "items": { "type": "string" } },
        "industry": { "type": "string" }
      },
      "required": ["id", "type", "title", "description"]
    }
  },
  "required": ["@context", "type", "issuer", "credentialSubject"]
}
