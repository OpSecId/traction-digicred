{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketplace.example.com/schemas/MarketplaceProfileCredential.json",
  "title": "MarketplaceProfileCredential",
  "description": "W3C Verifiable Credential attesting that an organization is an approved marketplace participant. Uses schema.org Organization and W3C VCDM 2.0.",
  "type": "object",
  "properties": {
    "@context": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "type": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "id": { "type": "string", "format": "uri" },
    "issuer": { "type": ["string", "object"] },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "credentialSubject": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uri" },
        "type": { "const": "Organization" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email", "description": "Deprecated: use contactPoint.email" },
        "contactPoint": {
          "type": "object",
          "properties": {
            "type": { "const": "ContactPoint" },
            "email": { "type": "string", "format": "email" },
            "name": { "type": "string" },
            "telephone": { "type": "string" }
          }
        },
        "url": { "type": "string", "format": "uri" },
        "address": { "type": "object" },
        "industry": { "type": "string" },
        "tenancyType": { "type": "string" }
      },
      "required": ["id", "type", "name"]
    }
  },
  "required": ["@context", "type", "issuer", "credentialSubject"]
}
