{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketplace.example.com/schemas/ProgramCredential.json",
  "title": "ProgramCredential",
  "description": "W3C Verifiable Credential wrapping a schema.org EducationalOccupationalProgram. Use for verifiable degree/certificate program listings.",
  "type": "object",
  "properties": {
    "@context": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2,
      "description": "First: https://www.w3.org/ns/credentials/v2, second: https://schema.org"
    },
    "type": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2
    },
    "id": { "type": "string", "format": "uri" },
    "issuer": { "type": ["string", "object"] },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "credentialSubject": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uri" },
        "type": { "const": "EducationalOccupationalProgram" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "applicationStartDate": { "type": "string", "format": "date" },
        "applicationDeadline": { "type": ["string", "object"], "description": "Date or text for rolling admissions" },
        "educationalProgramMode": { "type": "string" },
        "educationalCredentialAwarded": { "type": ["string", "object"] },
        "numberOfCredits": { "type": "number" },
        "timeToComplete": { "type": "string" },
        "provider": { "type": "object" },
        "programPrerequisites": { "type": ["string", "object", "array"] },
        "maximumEnrollment": { "type": "integer" },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "offers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "const": "Offer" },
              "category": { "type": "string" },
              "priceSpecification": { "type": "object" }
            }
          }
        }
      },
      "required": ["id", "type", "name", "description"]
    }
  },
  "required": ["@context", "type", "issuer", "credentialSubject"]
}
