{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketplace.example.com/schemas/ReservationCredential.json",
  "title": "ReservationCredential",
  "description": "W3C Verifiable Credential wrapping a schema.org Reservation. Use for marketplace tenancy reservations (includes KYC form data).",
  "type": "object",
  "properties": {
    "@context": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2,
      "description": "First: https://www.w3.org/ns/credentials/v2, second: marketplace context URI"
    },
    "type": { "type": "array", "items": { "type": "string" }, "minItems": 2 },
    "id": { "type": "string", "format": "uri" },
    "issuer": { "type": ["string", "object"] },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "credentialSubject": {
      "type": "object",
      "properties": {
        "type": { "const": "Reservation" },
        "reservationId": { "type": "string" },
        "reservationStatus": { "type": "string" },
        "reservationFor": { "type": "object", "description": "Thing being reserved (MarketplaceTenancy for tenancy reservations)" },
        "underName": {
          "oneOf": [
            { "$ref": "#/$defs/Person" },
            { "$ref": "#/$defs/Organization" }
          ],
          "description": "Person or organization the reservation is for"
        },
        "provider": {
          "oneOf": [
            { "$ref": "#/$defs/Person" },
            { "$ref": "#/$defs/Organization" }
          ],
          "description": "Service provider (marketplace for tenancy reservations)"
        },
        "broker": {
          "oneOf": [
            { "$ref": "#/$defs/Person" },
            { "$ref": "#/$defs/Organization" }
          ],
          "description": "Entity that arranged the reservation"
        },
        "totalPrice": { "type": ["number", "string"] },
        "priceCurrency": { "type": "string" }
      },
      "required": ["type", "reservationId"]
    }
  },
  "$defs": {
    "Person": {
      "type": "object",
      "properties": { "type": { "const": "Person" }, "name": { "type": "string" }, "email": { "type": "string" } }
    },
    "Organization": {
      "type": "object",
      "properties": {
        "type": { "const": "Organization" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "id": { "type": "string" },
        "contactPoint": { "$ref": "#/$defs/ContactPoint" },
        "registrationId": { "type": "string" },
        "jurisdiction": { "type": "string" },
        "address": { "type": "object" },
        "url": { "type": "string" },
        "industry": { "type": "string" },
        "intendedUse": { "type": "string" }
      }
    },
    "ContactPoint": {
      "type": "object",
      "properties": {
        "type": { "const": "ContactPoint" },
        "name": { "type": "string" },
        "jobTitle": { "type": "string" },
        "telephone": { "type": "string" },
        "email": { "type": "string" }
      }
    }
  },
  "required": ["@context", "type", "credentialSubject"]
}
