{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marketplace.example.com/schemas/WorkBasedProgramCredential.json",
  "title": "WorkBasedProgramCredential",
  "description": "W3C Verifiable Credential wrapping a schema.org WorkBasedProgram. Use for verifiable apprenticeship/internship program listings.",
  "type": "object",
  "properties": {
    "@context": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2,
      "description": "First: https://www.w3.org/ns/credentials/v2, second: https://schema.org"
    },
    "type": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 2
    },
    "id": { "type": "string", "format": "uri" },
    "issuer": { "type": ["string", "object"] },
    "validFrom": { "type": "string", "format": "date-time" },
    "validUntil": { "type": "string", "format": "date-time" },
    "credentialSubject": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "format": "uri" },
        "type": { "const": "WorkBasedProgram" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "occupationalCategory": { "type": "string" },
        "occupationalCredentialAwarded": { "type": ["string", "object"] },
        "educationalCredentialAwarded": { "type": ["string", "object"] },
        "trainingSalary": { "type": "object" },
        "salaryUponCompletion": { "type": "object" },
        "provider": { "type": "object" },
        "timeToComplete": { "type": "string" },
        "educationalProgramMode": { "type": "string" },
        "applicationDeadline": { "type": ["string", "object"] }
      },
      "required": ["id", "type", "name", "description"]
    }
  },
  "required": ["@context", "type", "issuer", "credentialSubject"]
}
