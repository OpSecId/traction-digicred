{
  "name": "marketplace",
  "version": "1.0.0",
  "description": "Apply Utopia Marketplace PWA - Job discovery and employer onboarding",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:frontend\"",
    "dev:server": "ts-node src/server.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "node scripts/embed-demo.js && cd frontend && npm run build",
    "preview": "cd frontend && npm run preview",
    "start": "node dist/server.js",
    "build:all": "cd frontend && npm run build && cd .. && tsc"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.1",
    "concurrently": "^9.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
