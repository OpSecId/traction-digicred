{
  "name": "marketplace",
  "version": "1.0.0",
  "description": "Apply Utopia Marketplace PWA - Job discovery and employer onboarding",
  "scripts": {
    "postinstall": "cd frontend && npm install",
    "dev": "concurrently \"npm run dev:server\" \"wait-on http://127.0.0.1:5174/api/agents/admin/status -t 30000 && npm run dev:frontend\"",
    "dev:server": "ts-node src/server.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "preview": "cd frontend && npm run preview",
    "start": "node dist/server.js",
    "build:all": "cd frontend && npm run build && cd .. && tsc"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "express": "^4.21.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.9.2",
    "js-yaml": "^4.1.0",
    "mongodb": "^7.1.0",
    "pg": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.1",
    "@types/pg": "^8.16.0",
    "concurrently": "^9.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "wait-on": "^8.0.1"
  }
}
